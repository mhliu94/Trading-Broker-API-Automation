{
  "api_key": "${BITGET_API_KEY}",
  "api_secret": "${BITGET_API_SECRET}",
  "passphrase": "${BITGET_PASSPHRASE}",
  "account_type": "stock_plus",
  "asset_class": "us_equity",
  "timezone": "America/New_York",
  "default_outside_rth": "Auto",
  "fok_policy": "native",
  "ioc_policy": "timed_cancel",
